# ---- Qdrant (pick ONE option) ----
# A) Docker on your machine (default):
QDRANT_URL=http://localhost:6333
# B) Qdrant Cloud free cluster: set URL + key
# QDRANT_URL=https://xxxx.cloud.qdrant.io:6333
# QDRANT_API_KEY=your-qdrant-cloud-key
# C) No Docker, embedded file storage (leave QDRANT_URL empty):
# QDRANT_URL=
# QDRANT_PATH=./qdrant_data

QDRANT_COLLECTION=rag_chunks

# ---- Gemini (free key: https://aistudio.google.com/apikey) ----
GEMINI_API_KEY=your-gemini-key
GEN_MODEL=gemini-2.5-flash
